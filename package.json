{
  "name": "nard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nard/ui dev",
    "build": "pnpm -r build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "typecheck": "tsc -b --force --pretty false",
    "shots": "tsx tools/shots.ts",
    "selfplay": "tsx tools/selfplay.ts",
    "difftest": "tsx tools/difftest.ts",
    "motion": "tsx tools/motion.ts",
    "check": "pnpm typecheck && pnpm test",
    "playtest": "tsx tools/playtest.ts",
    "sound": "tsx tools/sound.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
